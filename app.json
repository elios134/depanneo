{
  "expo": {
    "name": "Dépannéo",
    "slug": "depanneo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "depanneo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "fr.depanneo.app"
    },
    "android": {
      "package": "fr.depanneo.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 288
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Dépannéo utilise ta position pour trouver les plombiers et électriciens proches."
        }
      ],
      "@sentry/react-native/expo",
      "./plugins/sentry-sans-envoi.js",
      [
        "expo-image-picker",
        {
          "photosPermission": "Dépannéo utilise tes photos pour joindre une photo de la panne ou de ton logement.",
          "cameraPermission": "Dépannéo utilise l'appareil photo pour photographier la panne ou ton logement.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
